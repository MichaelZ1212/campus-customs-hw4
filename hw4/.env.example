# Copy to .env or set these in the shell that launches Uvicorn.
OPENAI_API_KEY=replace-with-your-api-key
# Alternatively use the course Portkey gateway instead of OPENAI_API_KEY:
# PORTKEY_API_KEY=replace-with-your-portkey-key
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
CAMPUS_CUSTOMS_AI_MODEL=gpt-5.6-luna
CAMPUS_CUSTOMS_SESSION_SECRET=replace-with-a-long-random-secret
